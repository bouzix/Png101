<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json|artisan)$ - [F,L]

    # Route everything through public/ for shared hosting (Namecheap)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

